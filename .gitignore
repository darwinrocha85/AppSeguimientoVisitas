# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sqlite local (nunca commitear la base de datos)
*.db
*.db-journal

# vercel
.vercel

# notas locales de ejecución (contienen usuarios/claves demo, no publicar)
run.md

# typescript
*.tsbuildinfo
next-env.d.ts

# pwa generado en cada build (next-pwa)
public/sw.js
public/workbox-*.js
public/sw.js.map
